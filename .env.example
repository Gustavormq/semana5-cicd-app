# Database Credentials
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Backend Configuration
DEBUG=True
ALLOWED_HOSTS=*
